# Etherscan API key — used for contract verification and gas price queries
# Get yours at: https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Etherscan API base URL (no change needed)
ETHERSCAN_API_URL=https://api.etherscan.io/api

# Alchemy RPC endpoint for Ethereum mainnet
# Get yours at: https://www.alchemy.com/
URL=https://eth-mainnet.g.alchemy.com/v2/your_alchemy_api_key_here

# Telegram bot token — get one from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Comma-separated list of Telegram user IDs allowed to use the bot
# Find your Telegram user ID via @userinfobot
AUTHORIZED_USER_IDS=123456789,987654321
